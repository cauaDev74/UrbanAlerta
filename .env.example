# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub (ele já está no .gitignore).
# Formato: CHAVE=valor, sem aspas, sem espaços em volta do "=" e sem comentário no fim da linha.
# Evite espaços, acentos e os caracteres $ { } # \ nas senhas.

# Banco PostgreSQL obrigatório (por exemplo, Supabase).
spring.profiles.active=banco

# Supabase: Connect > Session pooler. Substitua pelos dados do seu projeto.
DB_URL=jdbc:postgresql://<HOST-DO-POOLER>:5432/postgres?sslmode=require
DB_USER=postgres.<CODIGO-DO-PROJETO>
DB_PASSWORD=<SENHA-DO-BANCO>

# Gere um segredo aleatório com pelo menos 32 caracteres (ex.: openssl rand -base64 48).
JWT_SEGREDO=<SEGREDO-ALEATORIO-COM-32-OU-MAIS-CARACTERES>

# Administrador inicial, criado na primeira execução. Sem ADMIN_SENHA, nenhum admin é criado.
ADMIN_EMAIL=<EMAIL-DO-ADMINISTRADOR>
ADMIN_SENHA=<SENHA-FORTE-DO-ADMINISTRADOR>
